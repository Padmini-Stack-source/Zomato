pipeline {

    agent any

    tools {
        jdk 'jdk21'
        nodejs 'node18'
    }

    environment {
        AWS_REGION = 'ap-south-1'

        ECR_REPOSITORY = 'zomato'
        ECR_REGISTRY = '961544628689.dkr.ecr.ap-south-1.amazonaws.com'
        ECR_IMAGE = "${ECR_REGISTRY}/${ECR_REPOSITORY}"

        EKS_CLUSTER = 'zomato-eks'

        IMAGE_TAG = "${BUILD_NUMBER}"
        FULL_IMAGE = "${ECR_IMAGE}:${BUILD_NUMBER}"
    }

    stages {

        stage('Clean Workspace') {
            steps {
                cleanWs()
            }
        }

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Verify Tools') {
            steps {
                sh '''
                    echo "===== Tool Versions ====="
                    java -version
                    node --version
                    npm --version
                    docker --version
                    aws --version
                    kubectl version --client
                    echo "========================="
                '''
            }
        }

        stage('Install Dependencies') {
            steps {
                sh 'npm ci'
            }
        }

        stage('Application Build') {
            steps {
                sh 'npm run build'
            }
        }

        stage('Docker Build') {
            steps {
                sh '''
                    echo "===== Building Docker Image ====="

                    docker build \
                        -t ${ECR_IMAGE}:${IMAGE_TAG} \
                        -t ${ECR_IMAGE}:latest \
                        .

                    echo "Docker image build completed."
                '''
            }
        }

        stage('Docker Image Check') {
            steps {
                sh '''
                    echo "===== Docker Images ====="
                    docker images ${ECR_IMAGE}
                '''
            }
        }

        stage('Login to Amazon ECR') {
            steps {
                sh '''
                    echo "===== Login to Amazon ECR ====="

                    aws ecr get-login-password \
                        --region ${AWS_REGION} | \
                    docker login \
                        --username AWS \
                        --password-stdin ${ECR_REGISTRY}

                    echo "ECR login successful."
                '''
            }
        }

        stage('Push Image to ECR') {
            steps {
                sh '''
                    echo "===== Pushing Image to ECR ====="

                    docker push ${ECR_IMAGE}:${IMAGE_TAG}
                    docker push ${ECR_IMAGE}:latest

                    echo "Image pushed successfully."
                '''
            }
        }

        stage('Verify ECR Image') {
            steps {
                sh '''
                    echo "===== Verifying ECR Image ====="

                    aws ecr describe-images \
                        --repository-name ${ECR_REPOSITORY} \
                        --image-ids imageTag=${IMAGE_TAG} \
                        --region ${AWS_REGION}

                    echo "ECR image verification successful."
                '''
            }
        }

        stage('Deploy to EKS Staging') {
            steps {
                sh '''
                    echo "===== Deploying to EKS STAGING ====="
                    echo "Image: ${FULL_IMAGE}"

                    kubectl apply \
                        -f Kubernetes/deployment-staging.yaml

                    kubectl apply \
                        -f Kubernetes/service-staging.yaml

                    kubectl -n staging set image \
                        deployment/zomato \
                        zomato=${FULL_IMAGE}

                    kubectl -n staging rollout status \
                        deployment/zomato \
                        --timeout=5m

                    echo "STAGING deployment successful."
                '''
            }
        }

        stage('Staging Validation') {
            steps {
                sh '''
                    echo "===== STAGING VALIDATION ====="

                    kubectl get deployment \
                        zomato \
                        -n staging

                    kubectl get pods \
                        -n staging \
                        -o wide

                    kubectl get service \
                        zomato \
                        -n staging

                    kubectl rollout status \
                        deployment/zomato \
                        -n staging \
                        --timeout=5m

                    echo "===== STAGING VALIDATION PASSED ====="
                '''
            }
        }
       
        stage('Deploy to EKS Production') {
            steps {
                sh '''
                    echo "===== Deploying to EKS PRODUCTION ====="
                    echo "Image: ${FULL_IMAGE}"

                    kubectl apply \
                        -f Kubernetes/deployment-production.yaml

                    kubectl apply \
                        -f Kubernetes/service-production.yaml

                    kubectl -n production set image \
                        deployment/zomato \
                        zomato=${FULL_IMAGE}

                    kubectl -n production rollout status \
                        deployment/zomato \
                        --timeout=5m

                    echo "PRODUCTION deployment successful."
                '''
            }
        }

        stage('Production Validation') {
            steps {
                sh '''
                    echo "===== PRODUCTION VALIDATION ====="

                    kubectl get deployment \
                        zomato \
                        -n production

                    kubectl get pods \
                        -n production \
                        -o wide

                    kubectl get service \
                        zomato \
                        -n production

                    kubectl rollout status \
                        deployment/zomato \
                        -n production \
                        --timeout=5m

                    echo "===== PRODUCTION DEPLOYMENT SUCCESSFUL ====="
                '''
            }
        }
    }

    post {

        success {
            echo """
            ==========================================
            ZOMATO CI/CD PIPELINE SUCCESSFUL
            ==========================================
            Build Number : ${BUILD_NUMBER}
            Docker Image : ${FULL_IMAGE}
            ECR          : ${ECR_IMAGE}
            EKS Cluster  : ${EKS_CLUSTER}
            Region       : ${AWS_REGION}

            Staging      : DEPLOYED
            Production   : DEPLOYED
            ==========================================
            """
        }

        failure {
            echo """
            ==========================================
            ZOMATO CI/CD PIPELINE FAILED
            ==========================================
            Build Number : ${BUILD_NUMBER}
            Check Jenkins console output.
            ==========================================
            """
        }

        always {
            sh '''
                docker logout ${ECR_REGISTRY} || true
            '''

            cleanWs()
        }
    }
}
